# OPC Multi-Agent Platform - Environment Variables
# Copy this file to .env and fill in your API keys
# 首次部署时只需在 Settings 页面配置一次，系统会自动持久化到 .env

# LLM Provider: xiaomi / openai / deepseek / claude / zhipu
LLM_PROVIDER=xiaomi
LLM_MODEL=mimo-v2.5

# API Base URL
LLM_API_BASE=https://api.xiaomimimo.com/v1

# API Key (在 Settings 页面配置后自动写入，无需手动编辑此文件)
LLM_API_KEY=
